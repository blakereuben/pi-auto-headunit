# M5 appliance boot service: runs the head unit fullscreen, on its own
# dedicated Wayland compositor (`cage`, a kiosk compositor purpose-built
# for "run one fullscreen app" — packaged for Raspberry Pi OS Trixie),
# not inside the operator's existing desktop session.
#
# A *template* unit (the `@` in the filename) — instantiate it against a
# specific, currently-unused virtual terminal, e.g.
# `aa-headunit-kiosk@tty2.service`. Deliberately not tty1: real-hardware
# inspection this session (`loginctl list-sessions`) found the operator's
# own interactive desktop (`labwc`) already running there, and losing
# that would be a real regression, not just an inconvenience. Pick
# whichever VT is actually free on the target machine.
#
# The `[Unit]`/`[Service]` shape below (`After=`/`Before=`/
# `ConditionPathExists=`/`Wants=`, `PAMName=`/`TTYPath=`/`TTYReset=`/
# `TTYVHangup=`/`TTYVTDisallocate=`/`StandardInput=tty-fail`) matches
# cage's own documented systemd deployment recipe
# (https://github.com/cage-kiosk/cage/wiki/Starting-Cage-on-boot-with-systemd),
# verified against that source rather than guessed — `pam_systemd.so` in
# the matching PAM stack (`/etc/pam.d/aa-headunit-kiosk`, installed
# alongside this unit) is what actually registers a real logind
# session/seat for the process, which is what grants DRM device access
# (dynamically, via logind's seat ACLs) — not the `video`/`render` group
# membership `aa-headunit` already has from `postinst`, which matters for
# other things (backlight, GPU access outside a seat session) but isn't
# what a kiosk compositor's own DRM master role depends on.
#
# **Real-hardware-tested, 2026-08-18/19. `cage` gets stuck (unresponsive
# to a graceful stop) after a `chvt` to this unit's VT, at least once
# with the `WLR_DRM_DEVICES` fix below already in place** —
# `/sys/class/drm/card1-HDMI-*` (the `vc4` GPU node) was `disconnected`
# while the actual physical panel is `/sys/class/drm/card2-DSI-2`
# (`drm-rp1-dsi`, the RP1 southbridge's DSI driver); `WLR_DRM_DEVICES`
# forces the correct device, and a same-day real-hardware trial with it
# applied survived a full 60 seconds past `chvt` (every earlier trial,
# without the fix, hit trouble within that window) — genuine
# improvement, but not a confirmed full fix, since the same trial still
# got stuck a few minutes later.
#
# **Important correction to an earlier version of this note**: this was
# first believed to hang the *whole board*, requiring a physical power
# cycle — VNC went grey, a directly-attached keyboard stopped
# responding. Real-hardware investigation the same session found that's
# not quite right: `cage` gets stuck and stops responding to `SIGTERM`
# (confirmed via the journal: a `systemctl stop` sat for over a minute
# with zero progress, and an earlier trial logged `State 'stop-sigterm'
# timed out. Killing.` — systemd's own default 90s `TimeoutStopSec`),
# but **SSH stayed fully responsive throughout every single occurrence**
# — the kernel and the rest of the system were never actually frozen.
# `TimeoutStopSec=10` below makes systemd escalate to `SIGKILL`
# automatically and quickly instead of leaving an operator to wait out
# (or manually endure) the 90s default — recovery should never again
# require a physical power cycle; `systemctl kill -s KILL
# aa-headunit-kiosk@<VT>.service` (or waiting ~10s for this unit's own
# timeout to do it automatically) should be enough. See
# `docs/development/appliance-recovery.md` for the corrected recovery
# steps. The underlying question of *why* `cage` gets stuck at all is
# still open — this note records what's actually been confirmed, not a
# full fix.

[Unit]
Description=Android Auto head unit appliance kiosk session (%I)
Documentation=https://github.com/blakereuben/pi-auto-headunit
After=aa-headunit-preflight.service systemd-user-sessions.service plymouth-quit-wait.service
Requires=aa-headunit-preflight.service
Before=graphical.target
ConditionPathExists=/dev/tty0
Wants=dbus.socket systemd-logind.service

[Service]
Type=simple
User=aa-headunit
Group=aa-headunit
PAMName=aa-headunit-kiosk
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
Environment=WLR_DRM_DEVICES=/dev/dri/card2
ExecStart=/usr/bin/cage -d -s -- /usr/bin/aa-headunit-diagnostics usb kiosk --allow-live-aap
Restart=on-failure
RestartSec=5
# Real-hardware finding (2026-08-19): `cage` can get stuck and stop
# responding to a graceful SIGTERM. The default `TimeoutStopSec` (90s)
# left an operator either waiting almost a minute and a half or
# incorrectly concluding the whole board had hung. A short timeout here
# makes systemd escalate to SIGKILL quickly and automatically instead.
TimeoutStopSec=10
# Incremental hardening (ARCHITECTURE.md §8) — only the directive with
# no plausible interaction with DRM/USB/audio/seat access is included
# here; widen this once the unit above is real-hardware-confirmed
# working at all, verifying each addition against real DRM/USB/audio
# behavior rather than adding a standard hardening block wholesale.
NoNewPrivileges=yes

[Install]
WantedBy=graphical.target
