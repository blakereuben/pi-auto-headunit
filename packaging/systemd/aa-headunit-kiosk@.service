# M5 appliance boot service: runs the head unit fullscreen, on its own
# dedicated Wayland compositor (`cage`, a kiosk compositor purpose-built
# for "run one fullscreen app" — packaged for Raspberry Pi OS Trixie),
# not inside the operator's existing desktop session.
#
# A *template* unit (the `@` in the filename) — instantiate it against a
# specific, currently-unused virtual terminal, e.g.
# `aa-headunit-kiosk@tty2.service`. Deliberately not tty1: real-hardware
# inspection this session (`loginctl list-sessions`) found the operator's
# own interactive desktop (`labwc`) already running there, and losing
# that would be a real regression, not just an inconvenience. Pick
# whichever VT is actually free on the target machine.
#
# The `[Unit]`/`[Service]` shape below (`After=`/`Before=`/
# `ConditionPathExists=`/`Wants=`, `PAMName=`/`TTYPath=`/`TTYReset=`/
# `TTYVHangup=`/`TTYVTDisallocate=`/`StandardInput=tty-fail`) matches
# cage's own documented systemd deployment recipe
# (https://github.com/cage-kiosk/cage/wiki/Starting-Cage-on-boot-with-systemd),
# verified against that source rather than guessed — `pam_systemd.so` in
# the matching PAM stack (`/etc/pam.d/aa-headunit-kiosk`, installed
# alongside this unit) is what actually registers a real logind
# session/seat for the process, which is what grants DRM device access
# (dynamically, via logind's seat ACLs) — not the `video`/`render` group
# membership `aa-headunit` already has from `postinst`, which matters for
# other things (backlight, GPU access outside a seat session) but isn't
# what a kiosk compositor's own DRM master role depends on.
#
# **Real-hardware-tested, 2026-08-18, and found to hang the whole board.**
# With `lightdm`/`labwc` (this session's interactive desktop, tty1)
# stopped or disabled and this unit as the *only* compositor, `cage`
# never spawned its child process at all — `/sys/class/drm/card1-HDMI-*`
# (the `vc4` GPU node) was `disconnected`, while the physical panel was
# actually `/sys/class/drm/card2-DSI-2` (`drm-rp1-dsi`, the RP1
# southbridge's DSI driver) — `connected`. wlroots (cage's compositor
# library) auto-selects a DRM device and appears to have picked the
# disconnected `vc4` node, leaving cage waiting on a connector that would
# never appear. `Environment=WLR_DRM_DEVICES=` below forces the correct
# device explicitly, mirroring how this project's own GStreamer/GTK4
# render path has always needed explicit output targeting rather than
# relying on autodetection (see `crates/media-gstreamer/src/render.rs`'s
# own history).
#
# Separately — and this is the part that actually caused the real-hardware
# finding above to matter — after a `chvt` to this unit's VT (both with
# and without a second live compositor present), the *board itself*
# hung hard enough to need a physical power cycle: VNC went grey, a
# directly-attached keyboard stopped responding, and no kernel
# panic/oops/hung-task message appears anywhere in the journal for that
# boot (checked directly, including `-k` kernel-only output) — consistent
# with a firmware/GPU-level lockup this OS never got to log, not a
# userspace crash. A hardware watchdog (`bcm2835-wdt`, 1-minute timeout)
# is active on this board, which may or may not be what actually
# recovers a future occurrence. **The `WLR_DRM_DEVICES` fix above has NOT
# been verified to resolve this** — testing stopped after multiple real
# hangs required physical intervention, and this unit was disabled again
# (`lightdm` re-enabled) rather than risk another one. Before the next
# real test: confirm `WLR_DRM_DEVICES=/dev/dri/card2` is still the right
# card path (`for f in /sys/class/drm/card*-*/status; do echo "$f:
# $(cat $f)"; done` — look for `connected`), and treat a repeat hang as
# evidence this is a real firmware/DRM-driver bug independent of the
# wrong-device theory, not something this project's own code can fix.

[Unit]
Description=Android Auto head unit appliance kiosk session (%I)
Documentation=https://github.com/blakereuben/pi-auto-headunit
After=aa-headunit-preflight.service systemd-user-sessions.service plymouth-quit-wait.service
Requires=aa-headunit-preflight.service
Before=graphical.target
ConditionPathExists=/dev/tty0
Wants=dbus.socket systemd-logind.service

[Service]
Type=simple
User=aa-headunit
Group=aa-headunit
PAMName=aa-headunit-kiosk
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
Environment=WLR_DRM_DEVICES=/dev/dri/card2
ExecStart=/usr/bin/cage -d -s -- /usr/bin/aa-headunit-diagnostics usb kiosk --allow-live-aap
Restart=on-failure
RestartSec=5
# Incremental hardening (ARCHITECTURE.md §8) — only the directive with
# no plausible interaction with DRM/USB/audio/seat access is included
# here; widen this once the unit above is real-hardware-confirmed
# working at all, verifying each addition against real DRM/USB/audio
# behavior rather than adding a standard hardening block wholesale.
NoNewPrivileges=yes

[Install]
WantedBy=graphical.target
