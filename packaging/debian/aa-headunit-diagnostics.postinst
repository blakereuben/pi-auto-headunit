#!/bin/sh
set -e

# Real deployment finding (2026-08): running the diagnostics CLI as root
# (needed only because `/etc/aa-headunit` was root-only) breaks audio
# playback outright — PulseAudio/PipeWire refuse a connection from a uid
# that doesn't own the caller's own `XDG_RUNTIME_DIR`. USB access already
# works unprivileged via the `plugdev` udev rule (see
# `packaging/udev/70-aa-headunit.rules`); this makes credential access work
# unprivileged too, via a dedicated `aa-headunit` group rather than loosening
# any single file's own permissions. The private key file itself keeps its
# existing strict, no-group/no-other 0600 check
# (`crates/credential-store/src/linux.rs`) unchanged — this only widens who
# can traverse/write the *parent* directory to create their own credential
# files there, once, unprivileged.

# Best-effort: the real login account (if any) already running the
# desktop on seat0 at install time — used only to auto-configure
# autologin/group-membership/autostart for whichever account the
# operator is already using (ARCHITECTURE.md §8, see the "M5" block
# below). This app installs onto an existing PiOS desktop and should
# run as whoever's already using it, not a separate dedicated account
# (that was an earlier design, dropped — see
# `packaging/labwc/aa-headunit-autostart`'s own header comment). Never
# used for anything security-sensitive on its own — worst case of a
# wrong/empty detection is simply that autologin/autostart don't get
# configured automatically, requiring the one-time manual steps in
# `docs/development/credential-provisioning.md` instead.
detect_active_desktop_user() {
    if ! command -v loginctl >/dev/null 2>&1; then
        return 0
    fi
    for session_id in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
        seat=$(loginctl show-session "$session_id" -p Seat --value 2>/dev/null || true)
        state=$(loginctl show-session "$session_id" -p State --value 2>/dev/null || true)
        if [ "$seat" = "seat0" ] && [ "$state" = "active" ]; then
            loginctl show-session "$session_id" -p Name --value 2>/dev/null || true
            return 0
        fi
    done
}

case "$1" in
    configure)
        if ! getent group aa-headunit >/dev/null 2>&1; then
            addgroup --system aa-headunit
        fi
        # M5: a dedicated system group (ARCHITECTURE.md §8) anchoring
        # unprivileged access to /etc/aa-headunit, /var/lib/aa-headunit,
        # and (via `70-aa-headunit.rules`) USB — not a login identity.
        # The account itself is still created (some file ownership below
        # still names it directly), but nothing runs as this uid and
        # nothing logs in as it; the app runs as whichever real account
        # is detected below. No login shell, no created home directory.
        if ! getent passwd aa-headunit >/dev/null 2>&1; then
            adduser --system --ingroup aa-headunit --no-create-home \
                --home /var/lib/aa-headunit --shell /usr/sbin/nologin \
                aa-headunit
        fi

        active_user=$(detect_active_desktop_user)
        case "$active_user" in
            [a-zA-Z_][a-zA-Z0-9_-]*) ;;
            *) active_user="" ;;
        esac
        if [ -n "$active_user" ] && ! getent passwd "$active_user" >/dev/null 2>&1; then
            active_user=""
        fi
        active_home=""
        if [ -n "$active_user" ]; then
            active_home=$(getent passwd "$active_user" | cut -d: -f6)
        fi

        # Supplementary groups are narrow — exactly what this app has
        # ever actually needed on real hardware: `video` (backlight
        # brightness), `plugdev` (USB, `70-aa-headunit.rules`), `render`
        # (GPU/Wayland), `input` (evdev touch), `gpio` (`/dev/gpiochip*`,
        # the M5 night-mode GPIO input — Raspberry Pi OS's own default
        # udev rules already grant this group access to the chardev, so
        # no project-owned udev rule is needed here, unlike
        # `plugdev`/USB). Granted to both the (no-longer-logged-into)
        # `aa-headunit` account, for anything that still checks it
        # directly, and to the real detected account, which is what
        # actually needs device access now that the app runs as them.
        # `adduser <user> <group>` is idempotent on Debian (a no-op with
        # exit 0 if already a member), safe to re-run on every upgrade.
        for supplementary_group in video plugdev render input gpio; do
            if getent group "$supplementary_group" >/dev/null 2>&1; then
                adduser aa-headunit "$supplementary_group"
                if [ -n "$active_user" ]; then
                    adduser "$active_user" "$supplementary_group"
                fi
            fi
        done
        # Also give the detected account unprivileged access to
        # /etc/aa-headunit and /var/lib/aa-headunit below — previously a
        # manual step (`docs/development/credential-provisioning.md`),
        # now automatic for whoever installs the package. Real
        # credential *file* ownership migration is still not handled
        # here — see that doc.
        if [ -n "$active_user" ]; then
            adduser "$active_user" aa-headunit
        fi
        if [ -d /etc/aa-headunit ]; then
            chown root:aa-headunit /etc/aa-headunit
            chmod 0770 /etc/aa-headunit
        fi
        # Mutable operator state (currently just the gesture-settings
        # file, `gesture_settings.rs`) lives here per ARCHITECTURE.md §8's
        # /etc (admin config) vs /var/lib (mutable state) split — same
        # unprivileged-group pattern as /etc/aa-headunit above, so saving
        # settings never needs sudo either.
        mkdir -p /var/lib/aa-headunit
        chown root:aa-headunit /var/lib/aa-headunit
        chmod 0770 /var/lib/aa-headunit

        # Adopt a certificate/private-key pair staged by
        # `packaging/setup.sh` (the "run the wizard, then install"
        # entry point, operator's explicit direction 2026-08-24) or by
        # a standalone `credentials setup` run
        # (`credentials_setup_wizard.rs`) — both always write to this
        # same fixed spot in the detected active user's home directory,
        # never anywhere privileged, since neither can assume
        # `/etc/aa-headunit` (created just above) exists yet. Installs
        # via the exact same `credentials install` CLI path
        # `docs/development/credential-provisioning.md` documents for
        # manual use, as the detected user (not root, so the result is
        # owned the same way a normal unprivileged `credentials
        # install` run would leave it) — no-op, safely, if nothing was
        # staged, if this is only an upgrade, or if real credentials
        # already exist (that "install" call just fails harmlessly and
        # the stale staged copy is still cleaned up below). The main
        # app's own startup (`usb kiosk`) repeats this same adoption
        # check as a safety net in case this step is ever skipped
        # (e.g. no active desktop session detected at install time).
        if [ -n "$active_user" ] && [ -n "$active_home" ]; then
            staged_dir="$active_home/.local/share/aa-headunit/pending-credentials"
            if [ -f "$staged_dir/headunit.crt" ] && [ -f "$staged_dir/headunit.key" ]; then
                runuser -u "$active_user" -- \
                    /usr/bin/aa-headunit-diagnostics credentials install \
                    --certificate "$staged_dir/headunit.crt" \
                    --private-key "$staged_dir/headunit.key" || true
                rm -rf "$staged_dir"
            fi
        fi

        # Real deployment finding (2026-08-22): `usb wireless-bootstrap-probe`
        # (crate's own `wireless_bootstrap.rs`) brings up a temporary Wi-Fi
        # access point for the wireless Android Auto cold-start bootstrap,
        # which needs to configure `wlan0`'s address/admin state and needs
        # `hostapd`/`dnsmasq` binding/opening raw sockets on it — all of
        # which fail with "Operation not permitted" for a plain unprivileged
        # user, the same appliance user this whole package otherwise runs
        # as (see the `sudo` finding recorded elsewhere in this project:
        # running the app as root breaks Wayland/audio rendering outright,
        # so root is not an acceptable answer here either). `nmcli`/`rfkill`
        # are not included below — confirmed on real hardware that ordinary
        # NetworkManager polkit rules already permit an active local desktop
        # session to run those two unprivileged, without any file
        # capability grant, so widening them would be an unnecessary
        # privilege increase. `ip` is not included either (not a mistake):
        # a first attempt granted it the capability directly and found, via
        # `strace`, that Debian's own `ip` binary unconditionally drops all
        # of its capabilities the instant it starts if not real root —
        # deliberate upstream hardening this package cannot override, which
        # is exactly why `wireless_bootstrap.rs` no longer shells out to
        # `ip` at all and instead configures `wlan0` directly over netlink
        # from this package's own binary, which has no such self-dropping
        # logic of its own to fight.
        #
        # Fixed the same way `ping` and similar tools are traditionally
        # made to work for unprivileged users: `setcap` grants exactly
        # `CAP_NET_ADMIN`/`CAP_NET_RAW` (network interface configuration
        # and raw-socket access) plus `CAP_NET_BIND_SERVICE` (network
        # interface configuration, raw-socket access, and binding a
        # privileged port — not full root) directly on the binaries that
        # actually need them, rather than running any part of this app as
        # root. `CAP_NET_BIND_SERVICE` specifically was a second
        # real-hardware finding, 2026-08-23, one layer deeper than the
        # first: `dnsmasq` still failed even once its lease-file
        # permission problem was fixed, this time with "failed to bind
        # DHCP server socket: Permission denied" — DHCP's server port
        # (67/UDP) is itself a privileged port under 1024, a completely
        # separate check from `CAP_NET_ADMIN`/`CAP_NET_RAW`. Re-run on
        # every install/upgrade, since dpkg replaces these binaries with a
        # fresh inode each time and file capabilities do not survive that;
        # each binary's absence is tolerated (`|| true`) — `hostapd`/`dnsmasq`
        # come from separate packages this one only recommends, not
        # requires, and a missing one simply leaves wireless bootstrap
        # non-functional rather than breaking the rest of the appliance.
        if command -v setcap >/dev/null 2>&1; then
            for capable_binary in \
                /usr/bin/aa-headunit-diagnostics \
                /usr/sbin/hostapd \
                /usr/sbin/dnsmasq; do
                if [ -x "$capable_binary" ]; then
                    # `setcap` refuses a symlink ("must be a regular
                    # file") — real-hardware finding, 2026-08-22: some of
                    # this project's own supported install layouts could
                    # plausibly symlink a binary here even though none do
                    # today, so resolving defensively costs nothing (a
                    # no-op for an already-regular file, as all three are
                    # right now).
                    setcap cap_net_admin,cap_net_bind_service,cap_net_raw+ep \
                        "$(readlink -f "$capable_binary")" || true
                fi
            done
        fi

        # M5: point LightDM's autologin at the detected account and
        # install the fullscreen-app autostart into their own session —
        # only if autologin isn't already configured (never override an
        # operator's own choice, including one made before this package
        # was installed) and only if a real account was actually
        # detected. `/etc/lightdm/lightdm.conf` is not this package's
        # own file; this is a deliberate, narrow integration edit, not a
        # general rewrite.
        lightdm_conf=/etc/lightdm/lightdm.conf
        if [ -n "$active_user" ] && [ -f "$lightdm_conf" ] \
            && ! grep -Eq '^autologin-user=' "$lightdm_conf" \
            && grep -Eq '^\[Seat:\*\]' "$lightdm_conf"; then
            sed -i "/^\[Seat:\*\]/a autologin-session=rpd-labwc" "$lightdm_conf"
            sed -i "/^\[Seat:\*\]/a autologin-user=$active_user" "$lightdm_conf"
        fi
        if [ -n "$active_user" ]; then
            if [ -n "$active_home" ] && [ -d "$active_home" ] \
                && [ -f /usr/share/aa-headunit/labwc-autostart ]; then
                mkdir -p "$active_home/.config/labwc"
                install -m0644 /usr/share/aa-headunit/labwc-autostart \
                    "$active_home/.config/labwc/autostart"
                chown "$active_user:$active_user" \
                    "$active_home/.config/labwc" \
                    "$active_home/.config/labwc/autostart"
            fi
            # A manual way to launch the app regardless of the
            # "launch on boot" setting (`settings::HeadUnitSettings::
            # launch_on_boot`) — both a real desktop icon (if the
            # account has a Desktop folder — not created here if
            # missing, since an operator who deleted/never wanted one
            # shouldn't have it silently recreated) and an application-
            # menu entry (always installed; `~/.local/share/applications`
            # is a normal part of any XDG desktop account).
            if [ -n "$active_home" ] && [ -d "$active_home" ] \
                && [ -f /usr/share/aa-headunit/aa-headunit.desktop ]; then
                if [ -d "$active_home/Desktop" ]; then
                    install -m0755 /usr/share/aa-headunit/aa-headunit.desktop \
                        "$active_home/Desktop/aa-headunit.desktop"
                    chown "$active_user:$active_user" \
                        "$active_home/Desktop/aa-headunit.desktop"
                    # Real-hardware finding, 2026-08-26: GNOME/GTK's
                    # `GDesktopAppInfo` (what a double-click in the desktop
                    # file manager actually uses) refuses to even parse a
                    # `.desktop` launcher sitting in `~/Desktop` unless it
                    # carries this GVFS metadata attribute — a security
                    # hardening against a downloaded/copied `.desktop` file
                    # silently running arbitrary commands. Confirmed: the
                    # exact same file launches fine from
                    # `~/.local/share/applications` (a recognized XDG apps
                    # dir, exempt from this check) but fails from `Desktop`
                    # with "invalid desktop entry file" until this is set.
                    # Must run as the operator, not root — the attribute is
                    # stored per-user (`~/.local/share/gvfs-metadata`), and
                    # root's own store is a different file the operator's
                    # desktop session never reads. `|| true`: cosmetic only
                    # (a missing `gio` just means the operator has to
                    # right-click-trust it once themselves), never worth
                    # failing the whole install over.
                    runuser -u "$active_user" -- \
                        gio set "$active_home/Desktop/aa-headunit.desktop" \
                        metadata::trusted true >/dev/null 2>&1 || true
                fi
                mkdir -p "$active_home/.local/share/applications"
                install -m0755 /usr/share/aa-headunit/aa-headunit.desktop \
                    "$active_home/.local/share/applications/aa-headunit.desktop"
                chown -R "$active_user:$active_user" \
                    "$active_home/.local/share/applications"
            fi
            # App-menu entry only, deliberately NOT a Desktop icon —
            # operator's explicit direction, 2026-08-26: the one-stop
            # `packaging/setup.sh` installer already runs this exact
            # wizard as its own first step, so a separate "run the wizard
            # again" Desktop icon would make three icons appear after a
            # single install (app, setup, uninstall) instead of the two
            # the operator actually wants (app, uninstall). Still
            # available from the application menu for the rare case of
            # rotating credentials later without a full reinstall.
            if [ -n "$active_home" ] && [ -d "$active_home" ] \
                && [ -f /usr/share/aa-headunit/aa-headunit-setup.desktop ]; then
                mkdir -p "$active_home/.local/share/applications"
                install -m0755 /usr/share/aa-headunit/aa-headunit-setup.desktop \
                    "$active_home/.local/share/applications/aa-headunit-setup.desktop"
                chown -R "$active_user:$active_user" \
                    "$active_home/.local/share/applications"
            fi
            # Same pattern again, for a one-click way to remove the app —
            # `pkexec` (not a `Terminal=true` + `sudo`, which needs a
            # non-existent TTY to prompt for a password from a plain
            # double-click) shows the operator's normal desktop polkit
            # password dialog, matching the setup wizard's Browse button
            # or credential wizard flow: a GUI action asking for a GUI
            # confirmation, no terminal required.
            if [ -n "$active_home" ] && [ -d "$active_home" ] \
                && [ -f /usr/share/aa-headunit/aa-headunit-uninstall.desktop ]; then
                if [ -d "$active_home/Desktop" ]; then
                    install -m0755 /usr/share/aa-headunit/aa-headunit-uninstall.desktop \
                        "$active_home/Desktop/aa-headunit-uninstall.desktop"
                    chown "$active_user:$active_user" \
                        "$active_home/Desktop/aa-headunit-uninstall.desktop"
                    # See the kiosk icon's own comment above for why.
                    runuser -u "$active_user" -- \
                        gio set "$active_home/Desktop/aa-headunit-uninstall.desktop" \
                        metadata::trusted true >/dev/null 2>&1 || true
                fi
                mkdir -p "$active_home/.local/share/applications"
                install -m0755 /usr/share/aa-headunit/aa-headunit-uninstall.desktop \
                    "$active_home/.local/share/applications/aa-headunit-uninstall.desktop"
                chown -R "$active_user:$active_user" \
                    "$active_home/.local/share/applications"
            fi
        fi

        # Obsolete files from earlier designs (the VT-templated
        # `aa-headunit-kiosk@.service`/`cage` session, and its
        # `/var/lib/aa-headunit/.config/labwc/autostart` successor) — a
        # package upgrade does not remove these on its own since they
        # were shipped as plain, non-conffile files in earlier builds;
        # clean them up explicitly rather than leaving stale,
        # unreferenced files behind.
        rm -f /etc/pam.d/aa-headunit-kiosk
        rm -f /usr/lib/systemd/system/aa-headunit-kiosk@.service
        rm -f /usr/lib/systemd/system/aa-headunit-preflight.service
        rm -f /var/lib/aa-headunit/.config/labwc/autostart
        # Real-hardware finding (2026-08-18): installing/updating
        # `70-aa-headunit.rules` here via a plain `install -D` in
        # `packaging/debian/rules`, not `dh_installudev`, does not by
        # itself make the *already-running* `systemd-udevd` daemon
        # notice — it caches parsed rules and only reloads them on an
        # explicit request. Found while investigating a since-abandoned
        # udev-based fix for the MTP-popup issue documented in
        # `mtp_suppression.rs` (that fix didn't pan out, but this reload
        # gap is real and independent of it — worth keeping for
        # `70-aa-headunit.rules` itself on future upgrades). Confirmed
        # live: `udevadm test` (which always re-reads rule files itself,
        # independent of the daemon) reported a rule applying correctly
        # while a real triggered event on the live daemon did not, until
        # this reload ran.
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
        fi
        # M5: bounded, persistent journald logging
        # (`packaging/systemd/journald-40-rpi-volatile-storage.conf`) —
        # without this, a crashed boot's logs are gone the moment the
        # board reboots (real-hardware finding, same session: this
        # exact gap made the M5 appliance kiosk service's real hangs
        # undiagnosable until fixed — see
        # `docs/development/appliance-recovery.md`). Merely restarting
        # `systemd-journald` does not apply a journald.conf.d change to
        # the *already-running* daemon on its own — confirmed directly,
        # a `restart` alone left it still writing to the volatile
        # runtime location, and only an explicit `--flush` actually
        # migrated it.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl restart systemd-journald || true
        fi
        if command -v journalctl >/dev/null 2>&1; then
            journalctl --flush || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
