#!/bin/sh
set -e

# Real deployment finding (2026-08): running the diagnostics CLI as root
# (needed only because `/etc/aa-headunit` was root-only) breaks audio
# playback outright — PulseAudio/PipeWire refuse a connection from a uid
# that doesn't own the caller's own `XDG_RUNTIME_DIR`. USB access already
# works unprivileged via the `plugdev` udev rule (see
# `packaging/udev/70-aa-headunit.rules`); this makes credential access work
# unprivileged too, via a dedicated `aa-headunit` group rather than loosening
# any single file's own permissions. The private key file itself keeps its
# existing strict, no-group/no-other 0600 check
# (`crates/credential-store/src/linux.rs`) unchanged — this only widens who
# can traverse/write the *parent* directory to create their own credential
# files there, once, unprivileged.

case "$1" in
    configure)
        if ! getent group aa-headunit >/dev/null 2>&1; then
            addgroup --system aa-headunit
        fi
        # M5: a dedicated, unprivileged system user for the appliance
        # service itself (ARCHITECTURE.md §8), distinct from the
        # interactive-operator group-membership model above (still used
        # for the human-run diagnostics CLI). No login shell, no created
        # home directory (state already lives in /var/lib/aa-headunit,
        # which this account joins via its primary group like any other
        # `aa-headunit` group member). Supplementary groups are narrow —
        # exactly what this app has ever actually needed on real
        # hardware: `video` (backlight brightness), `plugdev` (USB, the
        # existing `70-aa-headunit.rules` grants this group access),
        # `render` (GPU/Wayland), `input` (evdev touch), `gpio`
        # (`/dev/gpiochip*`, the M5 night-mode GPIO input — Raspberry Pi
        # OS's own default udev rules already grant this group access to
        # the chardev, so no project-owned udev rule is needed here,
        # unlike `plugdev`/USB). `adduser <user> <group>` is idempotent
        # on Debian (a no-op with exit 0 if already a member), safe to
        # re-run on every upgrade.
        if ! getent passwd aa-headunit >/dev/null 2>&1; then
            adduser --system --ingroup aa-headunit --no-create-home \
                --home /var/lib/aa-headunit --shell /usr/sbin/nologin \
                aa-headunit
        fi
        for supplementary_group in video plugdev render input gpio; do
            if getent group "$supplementary_group" >/dev/null 2>&1; then
                adduser aa-headunit "$supplementary_group"
            fi
        done
        # PipeWire/Wayland need a real user session (XDG_RUNTIME_DIR,
        # a systemd --user instance) — lingering starts one at boot
        # without an interactive login, matching how the *human*
        # operator's own already-working audio path depends on owning
        # their session's XDG_RUNTIME_DIR (see the note above this
        # case statement). Not yet exercised end-to-end on real
        # hardware — the actual systemd units that will run as this
        # user are a separate, not-yet-built M5 item
        # (`MILESTONE_CHECKLIST.md`, "preflight and main systemd
        # services"). Credential access for this user is *not* set up
        # here — `docs/development/credential-provisioning.md` has the
        # ownership-migration steps for when that's needed, and this
        # script never touches real credential file ownership itself.
        if command -v loginctl >/dev/null 2>&1; then
            loginctl enable-linger aa-headunit || true
        fi
        if [ -d /etc/aa-headunit ]; then
            chown root:aa-headunit /etc/aa-headunit
            chmod 0770 /etc/aa-headunit
        fi
        # Mutable operator state (currently just the gesture-settings
        # file, `gesture_settings.rs`) lives here per ARCHITECTURE.md §8's
        # /etc (admin config) vs /var/lib (mutable state) split — same
        # unprivileged-group pattern as /etc/aa-headunit above, so saving
        # settings never needs sudo either.
        mkdir -p /var/lib/aa-headunit
        chown root:aa-headunit /var/lib/aa-headunit
        chmod 0770 /var/lib/aa-headunit
        # Real-hardware finding (2026-08-18): installing/updating
        # `70-aa-headunit.rules` here via a plain `install -D` in
        # `packaging/debian/rules`, not `dh_installudev`, does not by
        # itself make the *already-running* `systemd-udevd` daemon
        # notice — it caches parsed rules and only reloads them on an
        # explicit request. Found while investigating a since-abandoned
        # udev-based fix for the MTP-popup issue documented in
        # `mtp_suppression.rs` (that fix didn't pan out, but this reload
        # gap is real and independent of it — worth keeping for
        # `70-aa-headunit.rules` itself on future upgrades). Confirmed
        # live: `udevadm test` (which always re-reads rule files itself,
        # independent of the daemon) reported a rule applying correctly
        # while a real triggered event on the live daemon did not, until
        # this reload ran.
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
